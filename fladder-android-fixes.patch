+/**
+ * Adds a subtitle file picked from the device (content:// uri) to the current media item,
+ * keeps position / play state, and selects the new track once it is available.
+ */
+@OptIn(UnstableApi::class)
+fun ExoPlayer.addExternalSubtitle(context: Context, uri: Uri) {
+    try {
+        val current = currentMediaItem ?: return
+        val name = context.contentResolver
+            .query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)
+            ?.use { c -> if (c.moveToFirst()) c.getString(0) else null }
+            ?: "External subtitle"
+
+        val subtitle = MediaItem.SubtitleConfiguration.Builder(uri)
+            .setMimeType(guessSubtitleMimeType(name))
+            .setLabel(name)
+            .setLanguage("und")
+            .build()
+
+        val existing = current.localConfiguration?.subtitleConfigurations.orEmpty()
+        val newItem = current.buildUpon()
+            .setSubtitleConfigurations(existing + subtitle)
+            .build()
+
+        val position = currentPosition
+        val wasPlaying = playWhenReady
+        val player = this
+
+        player.addListener(object : Player.Listener {
+            override fun onTracksChanged(tracks: Tracks) {
+                val group = tracks.groups.firstOrNull { g ->
+                    g.type == C.TRACK_TYPE_TEXT &&
+                            (0 until g.length).any { i -> g.getTrackFormat(i).label == name }
+                } ?: return
+                player.removeListener(this)
+                player.trackSelectionParameters = player.trackSelectionParameters.buildUpon()
+                    .setTrackTypeDisabled(C.TRACK_TYPE_TEXT, false)
+                    .setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, 0))
+                    .build()
+            }
+        })
+
+        enableSubtitles()
+        setMediaItem(newItem, position)
+        prepare()
+        playWhenReady = wasPlaying
+    } catch (e: Exception) {
+        println("Error adding external subtitle: $e")
+    }
+}
